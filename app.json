{
  "expo": {
    "name": "YaID Wallet",
    "slug": "yaid-wallet",
    "version": "1.0.0",
    "scheme": "yaid",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "O YaID usa a câmera para fotografar seu documento de identidade e comprovar sua identidade."
      },
      "bundleIdentifier": "com.anonymous.yaid-wallet"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow YaID Wallet to access your identity."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O YaID usa a câmera para fotografar seu documento de identidade e comprovar sua identidade."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
